{
  "manifest_version": 3,
  "name": "Search-Only YouTube & Screen Time",
  "version": "1.3.1",
  "description": "Turns YouTube into a distraction-free search tool with active screen time monitoring.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Search-Only YouTube & Screen Time"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content_youtube.js"
      ],
      "css": [
        "content_youtube.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
